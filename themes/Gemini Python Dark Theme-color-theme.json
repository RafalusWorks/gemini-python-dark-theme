{
    "$schema": "vscode://schemas/color-theme",
    "name": "Gemini Python Dark Theme",
    "type": "dark",
    "colors": {
        // https://code.visualstudio.com/api/references/theme-color
        "editorCursor.foreground": "#BF86F2",
        // Title bar colors
        "titleBar.activeBackground": "#151515",
        "titleBar.inactiveBackground": "#151515",
        "titleBar.activeForeground": "#FFFFFF",
        "titleBar.inactiveForeground": "#888888",
        "titleBar.border": "#2A2A2A",
        // Tabs over the editor
        "editorGroupHeader.tabsBackground": "#151515",
        "tab.activeBackground": "#1F1F1F",
        "tab.inactiveBackground": "#151515",
        "tab.border": "#2A2A2A",
        // Main editor background
        "editor.background": "#1e1e1e",
        "editor.foreground": "#c6c6c6",
        "editorLineNumber.activeForeground": "#C4C4C4",
        "editor.lineHighlightBackground": "#262626",
        "editor.lineHighlightBorder": "#00000000",
        // Sidebar and activity bar
        "sideBar.background": "#252525",
        "activityBar.background": "#272727",
        "activityBar.border": "#303030",
        "sideBar.border": "#303030",
        "sideBarSectionHeader.background": "#1C1C1C",
        "sideBarSectionHeader.foreground": "#CCCCCC",
        "sideBarSectionHeader.border": "#303030",
        // Lower Left corner (remote)
        "statusBarItem.remoteBackground": "#272727",
        "statusBarItem.remoteForeground": "#BF86F2",
        // Panel bottom and status bar
        "panel.background": "#1A1A1A",
        "panel.border": "#2A2A2A",
        "panelTitle.border": "#2A2A2A",
        "statusBar.background": "#1E1E1E",
        "statusBar.border": "#2A2A2A",
        // Inlay hint colors
        "editorInlayHint.foreground": "#00e7ef",
        "editorInlayHint.background": "#2C313C",
        "editorInlayHint.typeForeground": "#794A1B",
        "editorInlayHint.typeBackground": "#2C313C",
        "editorInlayHint.parameterForeground": "#00e7ef",
        "editorInlayHint.parameterBackground": "#2C313C",
        //"editorGutter.background": "#1E1E1E",
        // "editorBracketHighlight.foreground1": "#C6C6C6",
        // "editorBracketHighlight.foreground2": "#C6C6C6",
        // "editorBracketHighlight.foreground3": "#C6C6C6",
        // "editorBracketHighlight.foreground4": "#C6C6C6",
        // "editorBracketHighlight.foreground5": "#C6C6C6",
        // "editorBracketHighlight.foreground6": "#C6C6C6",
    },
    "tokenColors": [
        {
            "name": "Comment",
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                // "fontStyle": "italic",
                "foreground": "#717171"
            }
        },
        {
            "name": "Docstrings",
            "scope": [
                "string.quoted.docstring",
                "string.quoted.docstring punctuation.definition.string"
            ],
            "settings": {
                // "fontStyle": "italic",
                "foreground": "#717171"
            }
        },
        {
            "name": "Keywords & Control Flow",
            "scope": [
                "keyword",
                "keyword.control"
            ],
            "settings": {
                "foreground": "#C792EA"
            }
        },
        {
            "name": "Storage & Types (def, class, fn, let, const)",
            "scope": [
                "storage.type",
                "storage.modifier"
            ],
            "settings": {
                "foreground": "#C792EA"
            }
        },
        {
            "name": "Functions & Methods (Declaration & Calls)",
            "scope": [
                "entity.name.function",
                "support.function"
            ],
            "settings": {
                "foreground": "#ffd451df"
            }
        },
        {
            "name": "Built-in Functions",
            "scope": [
                "support.function.builtin"
            ],
            "settings": {
                "foreground": "#82AAFF"
            }
        },
        {
            "name": "Generic Function Calls",
            "scope": [
                "meta.function-call.generic"
            ],
            "settings": {
                "foreground": "#C6C6C6"
            }
        },
        {
            "name": "Classes, Structs & Type Definitions",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "support.class"
            ],
            "settings": {
                "foreground": "#F7D161"
            }
        },
        {
            "name": "Built-in Types",
            "scope": [
                "support.type"
            ],
            "settings": {
                "foreground": "#82AAFF"
            }
        },
        {
            "name": "Strings & Text",
            "scope": [
                "string",
                "punctuation.definition.string"
            ],
            "settings": {
                "foreground": "#81C995"
            }
        },
        {
            "name": "Numbers & Numeric Literals",
            "scope": [
                "constant.numeric",
                "storage.type.number"
            ],
            "settings": {
                "foreground": "#E78A43"
            }
        },
        {
            "name": "Language Constants (True, False, None, null)",
            "scope": [
                "constant.language"
            ],
            "settings": {
                "foreground": "#E78A43"
            }
        },
        {
            "name": "ALL-CAPS & Static Constants",
            "scope": [
                "constant.other",
                "variable.other.constant"
            ],
            "settings": {
                "foreground": "#C6C6C6"
            }
        },
        {
            "name": "Variables & Identifiers (Base)",
            "scope": [
                "variable",
                "variable.other.readwrite"
            ],
            "settings": {
                "foreground": "#C6C6C6"
            }
        },
        {
            "name": "Parameters & Arguments",
            "scope": [
                "variable.parameter"
            ],
            "settings": {
                "foreground": "#C6C6C6"
            }
        },
        {
            "name": "Operators & Punctuation Delimiters",
            "scope": [
                "keyword.operator",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": {
                "foreground": "#C6C6C6"
            }
        },
        {
            "name": "Decorators & Annotations",
            "scope": [
                "entity.name.function.decorator",
                "punctuation.definition.decorator",
                "meta.annotation"
            ],
            "settings": {
                "foreground": "#82AAFF"
            }
        },
        {
            "name": "Object & Struct Properties",
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "support.variable.property",
                "entity.name.variable.field"
            ],
            "settings": {
                "foreground": "#C6C6C6"
            }
        },
        {
            "name": "JSON Keys",
            "scope": [
                "support.type.property-name.json",
                "support.type.property-name.json.comments",
                "punctuation.support.type.property-name.begin.json",
                "punctuation.support.type.property-name.end.json",
                "punctuation.support.type.property-name.begin.json.comments",
                "punctuation.support.type.property-name.end.json.comments"
            ],
            "settings": {
                "foreground": "#E78A43"
            }
        },
        {
            "name": "Escape Characters & Format Placeholders",
            "scope": [
                "constant.character.escape",
                "constant.other.placeholder"
            ],
            "settings": {
                "foreground": "#81C995"
            }
        },
        {
            "name": "Regular Expressions",
            "scope": [
                "string.regexp",
                "constant.regexp"
            ],
            "settings": {
                "foreground": "#81C995"
            }
        },
        {
            "name": "HTML/XML Tags and Attributes",
            "scope": [
                "entity.name.tag",
                "entity.other.attribute-name"
            ],
            "settings": {
                "foreground": "#C792EA"
            }
        },
        {
            "name": "Invalid / Illegal Syntax",
            "scope": [
                "invalid",
                "invalid.illegal"
            ],
            "settings": {
                "foreground": "#ff1111"
            }
        },
        {
            "name": "Markdown - Headings",
            "scope": [
                "punctuation.definition.heading.markdown",
                "entity.name.section.markdown",
                "markup.heading"
            ],
            "settings": {
                "fontStyle": "bold",
                "foreground": "#82AAFF"
            }
        },
        {
            "name": "Markdown - Inline Raw Code",
            "scope": [
                "markup.inline.raw.string.markdown",
                "markup.inline.raw",
                "punctuation.definition.raw.markdown"
            ],
            "settings": {
                "foreground": "#CE9178"
            }
        }
    ]
}